# ============================================================================
# Garrison 环境变量模板
# 复制本文件为 .env 并根据实际环境填写
# 所有 GARRISON_ 前缀的变量会被 GarrisonConfig::load 通过 confers 自动读取
# ============================================================================

# ---------------- 会话配置 ----------------
# 会话超时秒数（默认 2592000 = 30 天）
GARRISON_TIMEOUT=2592000

# 活跃超时秒数（-1 表示跟随 timeout，>0 表示无活动 N 秒后失效）
GARRISON_ACTIVE_TIMEOUT=-1

# 同账号多端共享会话（true / false）
GARRISON_IS_SHARE=false

# 允许同账号并发登录（true / false）
GARRISON_IS_CONCURRENT=true

# ---------------- Token 配置 ----------------
# Cookie / Header 名称
GARRISON_TOKEN_NAME=garrison_token

# Token 风格：uuid / random_64 / simple / jwt
GARRISON_TOKEN_STYLE=uuid

# 未登录时抛异常（true）或返回 false（false）
GARRISON_THROW_ON_NOT_LOGIN=true

# ---------------- JWT 配置（protocol-jwt feature） ----------------
# JWT 签名密钥（HS256/HS512 共用，生产环境必须修改）
GARRISON_JWT_SECRET=change-me-in-production

# JWT 算法：HS256 / HS512
GARRISON_JWT_ALGORITHM=HS256

# ---------------- 签名配置（protocol-sign feature） ----------------
# 签名时间窗口秒数（超过此窗口的请求被拒绝）
GARRISON_SIGN_WINDOW_SECONDS=300

# ---------------- SSO 配置（protocol-sso feature） ----------------
# SSO ticket 有效期秒数（默认 60 秒）
GARRISON_SSO_TICKET_TTL_SECONDS=60

# ---------------- 数据库配置（db-sqlite feature） ----------------
# SQLite 数据库文件路径
GARRISON_DB_URL=sqlite://garrison.db?mode=rwc

# ---------------- 缓存配置（cache-redis feature） ----------------
# Redis 连接 URL（cache-redis / rate-limit-redis feature 启用时）
# 单节点模式直接使用环境变量即可；多节点拓扑（Sentinel/Cluster/MasterSlave）
# 需通过 TOML 配置文件的 [redis] 段设置（见下方注释）。
GARRISON_REDIS_URL=redis://127.0.0.1:6379/0
#
# Redis 部署模式（通过 TOML 配置，以下为各模式示例）：
#
# [redis]
# password = "your-redis-password"   # 可选，认证密码
# db = 0                             # 数据库编号（0-15）
# connection_timeout_secs = 5        # 连接超时秒数
# pool_size = 10                     # 连接池大小
#
# ── 单节点（默认） ──
# [redis.mode]
# mode = "single"
# url = "redis://127.0.0.1:6379"
#
# ── Sentinel 哨兵模式（自动故障转移） ──
# [redis.mode]
# mode = "sentinel"
# master_name = "mymaster"
# urls = ["redis://s1:26379", "redis://s2:26379", "redis://s3:26379"]
#
# ── Cluster 集群模式（分片存储，至少 3 master） ──
# [redis.mode]
# mode = "cluster"
# urls = ["redis://c1:6379", "redis://c2:6379", "redis://c3:6379"]
#
# ── MasterSlave 主从模式（1 master + N slave） ──
# [redis.mode]
# mode = "master_slave"
# master_url = "redis://master:6379"
# slave_urls = ["redis://replica1:6379", "redis://replica2:6379"]

# ---------------- auth_server 二进制配置（src/bin/auth_server.rs） ----------------
# 内网 API Key（必需！fail-closed，未配置或为空时进程拒绝启动）
GARRISON_INTERNAL_API_KEY=change-me-to-a-strong-random-key

# 外网监听端口（默认 8080）
GARRISON_EXTERNAL_PORT=8080

# 内网监听端口（默认 8081）
GARRISON_INTERNAL_PORT=8081

# 外网每 IP 限速（每秒请求数，默认 100）
GARRISON_RATE_LIMIT=100

# ---------------- Web 安全配置（feature 门控） ----------------
# CORS 允许的源，逗号分隔（web-cors feature 启用时生效）
# GARRISON_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# 是否启用 CSRF 防护（web-csrf feature 启用时生效，true/false）
# GARRISON_CSRF_ENABLED=true

# 限流后端类型：memory / redis（rate-limit-redis feature 启用时生效）
# 选 redis 时需配合 GARRISON_REDIS_URL
# GARRISON_RATE_LIMIT_BACKEND=memory

# ---------------- 日志配置 ----------------
# 日志级别：error / warn / info / debug / trace
RUST_LOG=garrison=info

# ---------------- 可观测性（可选 feature） ----------------
# 启用 tracing 日志桥接（tracing-log feature）
GARRISON_TRACING_LOG=false

# 启用 Prometheus 指标（metrics-prometheus feature）
GARRISON_METRICS_PROMETHEUS=false

# Prometheus 指标暴露端口
GARRISON_METRICS_PORT=9090
